{
  "name": "mozi",
  "version": "0.0.0",
  "description": "Mozi CLI — the coding agent that lives in your terminal.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mozi": "./dist/index.cjs"
  },
  "files": ["dist/index.cjs", "dist/prompts"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "node scripts/bundle.mjs",
    "dev": "tsx src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@mozi/core": "workspace:*",
    "@mozi/protocol": "workspace:*",
    "@mozi/shared": "workspace:*",
    "@mozi/providers": "workspace:*",
    "@mozi/tools": "workspace:*",
    "commander": "^12.1.0"
  }
}
