{
  "name": "@mozi/desktop",
  "version": "0.0.0",
  "description": "Electron desktop app (main + renderer).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/main/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "node scripts/bundle.mjs",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json",
    "test": "vitest run",
    "dev": "vite",
    "electron": "electron ./dist/main/index.cjs",
    "package": "node scripts/package.mjs",
    "package:dir": "node scripts/package.mjs --dir",
    "package:mac": "node scripts/package.mjs --mac",
    "package:mac:intel": "node scripts/package.mjs --mac --arch x64",
    "package:mac:silicon": "node scripts/package.mjs --mac --arch arm64",
    "package:linux": "node scripts/package.mjs --linux"
  },
  "dependencies": {
    "@mozi/shared": "workspace:*",
    "@mozi/core": "workspace:*",
    "@mozi/protocol": "workspace:*",
    "@mozi/tools": "workspace:*",
    "@mozi/providers": "workspace:*"
  },
  "optionalDependencies": {
    "electron": "^33.0.0"
  },
  "devDependencies": {
    "electron-builder": "^26.15.3",
    "esbuild": "^0.21.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.mozi.desktop",
    "productName": "Mozi",
    "copyright": "Copyright © 2026 Mozi",
    "asar": true,
    "electronVersion": "33.4.11",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/main/index.cjs",
      "dist/preload.cjs",
      "dist/renderer/**/*",
      "dist/prompts/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mozi",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": null
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "Development"
    }
  }
}
